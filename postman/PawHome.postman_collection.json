      "key": "adopterToken",
      "value": ""
    },
    {
      "key": "shelterToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "petId",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""

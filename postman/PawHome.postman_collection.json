              "raw": "{\n  \"name\": \"Furry Friends Home\",\n  \"email\": \"furry@example.com\",\n  \"password\": \"furry123\",\n  \"role\": \"shelter\",\n  \"phone\": \"9988776655\",\n  \"city\": \"Noida\"\n}",
              "options": {
